{
  "permissions": {
    "allow": [
      "Bash(xcodebuild *)",
      "Bash(swift build*)",
      "Bash(swift test*)",
      "Bash(*/xcprojformatter *)",
      "Bash(xcprojformatter *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(mkdir -p docs/*)",
      "Bash(scripts/check.sh*)",
      "Bash(scripts/test-hooks.sh*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(xcrun simctl*)"
    ],
    "ask":  ["Bash(git push*)"],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin master*)",
      "Bash(sed -i*)",
      "Bash(python*)",
      "Bash(perl*)",
      "Bash(ruby*)",
      "Edit(**/project.pbxproj)",
      "Write(**/project.pbxproj)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-translations.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-shell-writes.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-xcproj.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-swift.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
